[Unit]
Description=FRP Server (frps) - Three-Brain AI Tunnel
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/frp_0.61.1_linux_arm64
ExecStart=/home/ubuntu/frp_0.61.1_linux_arm64/frps -c /home/ubuntu/frp_0.61.1_linux_arm64/frps.toml
Restart=always
RestartSec=5
StartLimitIntervalSec=0

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=frps

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/ubuntu/frp_0.61.1_linux_arm64

[Install]
WantedBy=multi-user.target