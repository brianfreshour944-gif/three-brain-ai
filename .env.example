# OpenRouter API Key (required for Strategist)
OPENROUTER_API_KEY=your_key_here

# Local llama.cpp server endpoints
MINISTRAL_BASE_URL=http://localhost:8001/v1
DEEPSEEK_BASE_URL=http://localhost:8002/v1

# Model names (as served by llama.cpp)
MINISTRAL_MODEL=ministral
DEEPSEEK_MODEL=deepseek
STRATEGIST_MODEL=anthropic/claude-3.5-sonnet

# Context window sizes
MINISTRAL_CTX=8192
DEEPSEEK_CTX=8192
STRATEGIST_CTX=200000

# Default temperatures
BUILDER_TEMP=0.3
ANALYST_TEMP=0.2
STRATEGIST_TEMP=0.1

# Task storage
TASKS_DIR=./tasks
MEMORY_DIR=./memory
LOGS_DIR=./logs

# Safety settings
REQUIRE_APPROVAL=true
BLOCKED_PATHS=.env,*.key,*.pem,secrets/,credentials/
PROTECTED_FILES=risk_engine.py,position_sizing.py,order_execution.py,broker.py