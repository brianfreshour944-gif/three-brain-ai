# Three-Brain AI Orchestrator — Environment Configuration
# Copy to .env and fill in your values

# ============================================================
# REQUIRED: OpenRouter API Key (for Strategist & Red Team)
# Get from: https://openrouter.ai/keys
# ============================================================
OPENROUTER_API_KEY=your_openrouter_key_here

# ============================================================
# MODEL ENDPOINTS (via FRP tunnel on Oracle localhost)
# These are FIXED addresses — never change even when Kaggle restarts
# ============================================================
MINISTRAL_BASE_URL=http://127.0.0.1:7001/v1
DEEPSEEK_BASE_URL=http://127.0.0.1:7002/v1

# ============================================================
# MODEL NAMES (as served by llama.cpp on Kaggle)
# ============================================================
MINISTRAL_MODEL=mistral-7b-instruct-v0.1.Q4_K_M
DEEPSEEK_MODEL=deepseek-coder-7b-instruct-v1.5.Q4_K_M
STRATEGIST_MODEL=openrouter/nemotron-3-ultra-free

# ============================================================
# TEMPERATURES
# ============================================================
BUILDER_TEMP=0.3
ANALYST_TEMP=0.2
STRATEGIST_TEMP=0.1

# ============================================================
# CONTEXT WINDOWS
# ============================================================
MINISTRAL_CTX=4096
DEEPSEEK_CTX=4096
STRATEGIST_CTX=200000

# ============================================================
# MAX COMPLETION TOKENS
# ============================================================
MINISTRAL_MAX_TOKENS=2048
DEEPSEEK_MAX_TOKENS=2048
STRATEGIST_MAX_TOKENS=8192

# ============================================================
# SAFETY SETTINGS
# ============================================================
REQUIRE_APPROVAL=true
BLOCKED_PATHS=.env,*.key,*.pem,secrets/,credentials/
PROTECTED_FILES=risk_engine.py,position_sizing.py,order_execution.py,broker.py

# ============================================================
# DIRECTORIES (inside container)
# ============================================================
TASKS_DIR=/app/tasks
MEMORY_DIR=/app/memory
LOGS_DIR=/app/logs

# ============================================================
# OPTIONAL: JetBrains Air License
# ============================================================
# AIR_LICENSE=your_jetbrains_air_license_here